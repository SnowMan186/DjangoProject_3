# .env.example - шаблон для настройки окружения

# Секретный ключ (Django сгенерирует сам, если не указать)
# SECRET_KEY=ваш_секретный_ключ

# Режим отладки
DEBUG=True

# Настройки БД (SQLite для разработки, PostgreSQL для продакшена)
DATABASE_URL=sqlite:///db.sqlite3

# Для PostgreSQL раскомментируйте строку ниже и закомментируйте SQLite
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

DB_NAME=your_db_name
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432